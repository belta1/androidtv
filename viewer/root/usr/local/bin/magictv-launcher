#!/bin/bash
# Connects to the redroid container, installs APKs from /apks and shows the
# screen (video + audio) with scrcpy directly on the host's desktop session.
# Behaves like a desktop app: opens a window when the session starts (AUTOSTART),
# stays closed when the user closes it until `magictv-open` is run, and retries
# on errors (logout, Android reboot).

ANDROID_HOST="${ANDROID_HOST:-android:5555}"
MAX_SIZE="${MAX_SIZE:-1920}"
FPS="${FPS:-60}"
VIDEO_BITRATE="${VIDEO_BITRATE:-8M}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
WL_NAME="${WAYLAND_DISPLAY:-wayland-0}"
X_NAME="${DISPLAY:-:0}"
FULLSCREEN="${FULLSCREEN:-false}"
WINDOW_WIDTH="${WINDOW_WIDTH:-1280}"
WINDOW_HEIGHT="${WINDOW_HEIGHT:-720}"
AUTOSTART="${AUTOSTART:-true}"
OPEN_REQUEST="$HOME/open-request"
# Window/app id so GNOME groups it under the "Magic TV" launcher icon
export SDL_APP_ID=magictv
APK_DIR="/apks"
STATE_DIR="$HOME/installed"
mkdir -p "$STATE_DIR"

log() { echo "[magictv] $*"; }

# Waits until the host user's desktop session is up and picks Wayland or X11.
wait_for_display() {
  unset PULSE_SERVER
  while true; do
    if [ -S "$XDG_RUNTIME_DIR/$WL_NAME" ]; then
      export WAYLAND_DISPLAY="$WL_NAME" SDL_VIDEO_DRIVER=wayland
      unset DISPLAY
      break
    elif [ -S "/tmp/.X11-unix/X${X_NAME#:}" ]; then
      export DISPLAY="$X_NAME" SDL_VIDEO_DRIVER=x11
      unset WAYLAND_DISPLAY
      break
    fi
    log "waiting for desktop session ($XDG_RUNTIME_DIR/$WL_NAME or X$X_NAME) ..."
    sleep 5
  done
  if [ -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    export PULSE_SERVER="unix:$XDG_RUNTIME_DIR/pulse/native"
  else
    log "no PulseAudio/PipeWire socket found, audio disabled"
  fi
  log "display: $SDL_VIDEO_DRIVER"
  return 0
}

wait_for_android() {
  until adb connect "$ANDROID_HOST" 2>/dev/null | grep -q "connected"; do
    log "waiting for $ANDROID_HOST ..."
    sleep 3
  done
  until [ "$(adb -s "$ANDROID_HOST" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
    log "waiting for Android boot ..."
    sleep 3
  done
  log "connected to $ANDROID_HOST ($(adb -s "$ANDROID_HOST" shell getprop ro.product.cpu.abilist | tr -d '\r'))"
}

install_apks() {
  shopt -s nullglob
  for apk in "$APK_DIR"/*.apk; do
    name="$(basename "$apk")"
    sum="$(sha256sum "$apk" | cut -d' ' -f1)"
    if [ "$(cat "$STATE_DIR/$name.sha256" 2>/dev/null)" = "$sum" ] \
       && [ -n "$(adb -s "$ANDROID_HOST" shell pm list packages -3 | tr -d '\r')" ]; then
      continue
    fi
    log "installing $name ..."
    if adb -s "$ANDROID_HOST" install -r -g "$apk"; then
      echo "$sum" > "$STATE_DIR/$name.sha256"
    else
      log "failed to install $name"
    fi
  done
}

detect_package() {
  if [ -n "$APP_PACKAGE" ]; then
    echo "$APP_PACKAGE"
  else
    adb -s "$ANDROID_HOST" shell pm list packages -3 | tr -d '\r' | head -n1 | sed 's/^package://'
  fi
}

session_up() {
  [ -S "$XDG_RUNTIME_DIR/$WL_NAME" ] || [ -S "/tmp/.X11-unix/X${X_NAME#:}" ]
}

# Blocks until `magictv-open` is run (desktop icon), or until a new desktop
# session starts while AUTOSTART=true.
wait_for_open_request() {
  local session_ended=0
  rm -f "$OPEN_REQUEST"
  log "closed; waiting for open request"
  while [ ! -e "$OPEN_REQUEST" ]; do
    if ! session_up; then
      session_ended=1
    elif [ $session_ended -eq 1 ] && [ "$AUTOSTART" = "true" ]; then
      log "new desktop session"
      return
    fi
    sleep 1
  done
  rm -f "$OPEN_REQUEST"
}

audio_args=()
rm -f "$OPEN_REQUEST"
[ "$AUTOSTART" = "true" ] || wait_for_open_request
while true; do
  wait_for_android
  install_apks
  wait_for_display
  [ -z "$PULSE_SERVER" ] && audio_args=(--no-audio) || audio_args=(--audio-codec opus --audio-buffer 60)

  pkg="$(detect_package)"
  start_args=()
  [ -n "$pkg" ] && start_args=(--start-app="$pkg") && log "starting $pkg"

  window_args=(--window-width "$WINDOW_WIDTH" --window-height "$WINDOW_HEIGHT")
  [ "$FULLSCREEN" = "true" ] && window_args=(--fullscreen)

  scrcpy -s "$ANDROID_HOST" \
    --window-title "Magic TV" \
    "${window_args[@]}" \
    --max-size "$MAX_SIZE" \
    --max-fps "$FPS" \
    --video-codec h264 \
    --video-bit-rate "$VIDEO_BITRATE" \
    "${audio_args[@]}" \
    "${start_args[@]}"
  rc=$?

  if [ $rc -eq 0 ]; then
    # Window closed by the user: stay closed until the launcher icon asks again
    log "window closed"
    wait_for_open_request
  else
    log "scrcpy exited ($rc), retrying in 3s"
    sleep 3
  fi
done
